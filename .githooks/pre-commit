#!/usr/bin/env bash
# Run `just check` when a commit touches the config. Enabled per clone with
# `just install-hooks`; skip once with `git commit --no-verify`.
# nix flake check reads the working tree, so unstaged edits are checked too.
set -eu
git diff --cached --name-only | grep -qE '\.nix$|^flake\.lock$|^checks/' || exit 0
exec just check
